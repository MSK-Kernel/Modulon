//String test: indexing a string with [], scanning it with strlen()
//and a manual loop, and comparing string contents with strcmp()
//rather than raw pointer equality.
#include <stdio.h>
#include <string.h>

int count_vowels(string s)
{
	int length = strlen(s);
	int i;
	int count = 0;
	for(i = 0; i < length; i = i + 1) {
		char c = s[i];
		if(c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u') {
			count = count + 1;
		}
	}
	return count;
}

int main()
{
	string word = "programming";
	int vowels = count_vowels(word);
	printf("word: %v (len %v)\n", word, strlen(word));
	printf("first letter: %v\n", word[0]);
	printf("vowels: %v\n", vowels);
	if(vowels == 3 && strcmp(word, "programming") == 0 && word[0] == 'p') {
		return 0;
	}
	return 1;
}
