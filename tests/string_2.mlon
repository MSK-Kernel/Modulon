// Multiple string assignments and return value checks

int format_msg(int code) {
    string prefix = "Error code: ";
    string msg = "";
    if (code == 0) {
        msg = "Success";
        return 0;
    } else {
        msg = "Failure";
        return code;
    }
}

int main() {
    int status1 = format_msg(0);
    int status2 = format_msg(404);
    return status1 + status2;
}
