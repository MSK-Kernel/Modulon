#include <stdio.h>

//example of the "match" function.

int main()
{
		var score = 95;
		match score
		{
			0...59: printf("F\n");
			60...69: printf("D\n");
			70...79: printf("C\n");
			80...89: printf("B\n");
			90...99: printf("A\n");
			100: printf("Perfect\n");
			_ if score < 0: printf("Invalid\n");
			_: printf("Out of range\n");
		}

		var grade = match score
		{
				0...59: "F";
				60...69: "D";
				70...79: "C";
				80...89: "B";
				90...99: "A";
				100: "A+";
				_: "Invalid";
		};
		printf("Grade: %s\n", grade);
		return 0;
}
