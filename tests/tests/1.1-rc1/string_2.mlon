//String test: building a new string on the heap with strcpy/strcat,
//swapping the source strings afterward to check the copy was
//independent, and comparing the assembled result with strcmp().
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

string join(string first, string second, string separator)
{
	string result;
	result = (string)malloc(strlen(first) + strlen(separator) + strlen(second) + 1);
	strcpy(result, first);
	strcat(result, separator);
	strcat(result, second);
	return result;
}

int main()
{
	string first = "hello";
	string second = "modulon";
	string greeting = join(first, second, ", ");
	printf("%v\n", greeting);
	first = "changed";
	second = "changed";
	if(strcmp(greeting, "hello, modulon") == 0 && strlen(greeting) == 14) {
		free(greeting);
		return 0;
	}
	free(greeting);
	return 1;
}
