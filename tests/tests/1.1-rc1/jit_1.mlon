// JIT test: external symbol resolution (GOT + thunks via the host dynamic
// linker), a mutable global (bss), recursion, and exit code propagation
// from main() through jit_run() back to the process.

#include <stdio.h>

int counter = 0;

int fib(int n)
{
	if(n < 2) return n;
	return fib(n - 1) + fib(n - 2);
}

int main()
{
	int i;
	for(i = 0; i < 10; i = i + 1) {
		counter = counter + fib(i);
	}
	printf("fib sum: %v\n", counter);
	if(counter == 88) {
		return 0;
	}
	return 1;
}
