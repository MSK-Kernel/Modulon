//Type test: struct type identity via typeof(), sizeof() for a struct
//versus its members, and unsigned 8-bit wraparound on overflow past
//255.
#include <stdio.h>

struct Pair
{
	int a;
	int b;
};

int main()
{
	struct Pair p1;
	struct Pair p2;
	uint8_t counter = 250;
	int i;
	p1.a = 1;
	p1.b = 2;
	p2.a = 3;
	p2.b = 4;
	for(i = 0; i < 10; i = i + 1) {
		counter = counter + 1;
	}
	printf("sizeof(struct Pair): %v\n", sizeof(struct Pair));
	printf("sizeof(int): %v\n", sizeof(int));
	printf("wrapped counter: %v\n", counter);
	if(typeof(p1) == typeof(p2) &&
	   sizeof(struct Pair) == 2 * sizeof(int) &&
	   counter == 4) {
		return 0;
	}
	return 1;
}
