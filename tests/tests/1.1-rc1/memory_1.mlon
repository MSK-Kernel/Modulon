//Memory test: struct layout, taking the address of a local, mutating
//fields through a pointer parameter with -> and *, and observing the
//mutation back through the original variable.
#include <stdio.h>

struct Point
{
	int x;
	int y;
};

void translate(struct Point *p, int dx, int dy)
{
	p->x = p->x + dx;
	(*p).y = p->y + dy;
}

int main()
{
	struct Point origin;
	struct Point *ptr;
	origin.x = 1;
	origin.y = 2;
	ptr = &origin;
	translate(ptr, 4, 5);
	printf("point: (%v, %v)\n", origin.x, origin.y);
	printf("via pointer: (%v, %v)\n", ptr->x, ptr->y);
	if(origin.x == 5 && origin.y == 7 && ptr->x == 5 && ptr->y == 7) {
		return 0;
	}
	return 1;
}
