// Integration test combining pattern matching and strings

int eval_code(int code) {
    match (code) {
        200 : return 0;
        404 : return 1;
        500 : return 2;
        default : return -1;
    }
}

int main() {
    string banner = "Modulon v1.1-beta test runner";
    int res1 = eval_code(200);
    int res2 = eval_code(404);
    int res3 = eval_code(999);
    
    return res1 + res2 + res3;
}
